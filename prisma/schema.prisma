datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  OPERATOR
  VIEWER
}

enum CameraStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  name      String
  role      Role     @default(OPERATOR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Building {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  floors    Int      @default(3)
  cameras   Camera[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DVR {
  id          String   @id @default(cuid())
  name        String
  brand       String   // Hikvision, Dahua, HiLook, Uniview, Honeywell
  ipOrDomain  String
  rtspPort    Int      @default(554)
  httpPort    Int      @default(80)
  channels    Int      @default(16)
  username    String
  password    String
  cameras     Camera[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Camera {
  id          String       @id @default(cuid())
  name        String
  buildingId  String
  building    Building     @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  dvrId       String?
  dvr         DVR?         @relation(fields: [dvrId], references: [id], onDelete: SetNull)
  floor       Int          @default(1)
  channel     Int          @default(1)
  streamUrl   String       // URL WebRTC / HLS dari relay server
  rtspUrl     String?      // String RTSP direct backup
  status      CameraStatus @default(ONLINE)
  isFavorite  Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([buildingId])
  @@index([dvrId])
}
