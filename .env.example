# Neon PostgreSQL connection string (pooled connection for Vercel serverless)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Direct DB connection string for Prisma migrations (non-pooled)
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# App JWT Secret & Options
JWT_SECRET="school-cctv-secret-key-change-in-production"
NEXT_PUBLIC_APP_NAME="VisiGuard CCTV Monitoring"

# Relay Streamer Endpoint Default (e.g. go2rtc or MediaMTX)
NEXT_PUBLIC_RELAY_SERVER_URL="https://stream.sekolah.sch.id"
